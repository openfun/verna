{
  "name": "verna-examples-playground",
  "private": true,
  "version": "1.0.0-beta.1",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "i18n:extract": "yarn formatjs extract --id-interpolation-pattern '[sha512:contenthash:base64:6]' --format crowdin './src/**/*.ts*' --out-file ./i18n/frontend.json",
    "i18n:compile": "yarn formatjs compile-folder --format crowdin ./i18n/locales ./src/translations",
    "lint:stylelint": "stylelint 'src/**/*.scss' --fix",
    "lint:eslint": "eslint 'src/**/*.{ts,tsx}'",
    "lint": "yarn lint:stylelint && yarn lint:eslint"
  },
  "dependencies": {
    "@openfun/verna": "1.0.0-beta.1",
    "@rjsf/core": "6.11.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-intl": "12.1.7"
  },
  "devDependencies": {
    "@formatjs/cli": "6.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "postcss": "8.5.33",
    "sass": "1.108.2",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "stylelint-config-standard-scss": "18.0.0",
    "stylelint-order": "8.1.3",
    "typescript": "4.8.4",
    "vite": "8.3.8"
  }
}
