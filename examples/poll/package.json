{
  "name": "verna-examples-poll",
  "private": true,
  "version": "1.0.0-beta.1",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "i18n:extract": "yarn formatjs extract --id-interpolation-pattern '[sha512:contenthash:base64:6]' --format crowdin './src/**/*.ts*' --out-file ./i18n/frontend.json",
    "i18n:compile": "yarn formatjs compile-folder --format crowdin ./i18n/locales ./src/translations",
    "lint:stylelint": "stylelint 'src/**/*.scss' --fix",
    "lint:eslint": "eslint 'src/**/*.{ts,tsx}'",
    "lint": "yarn lint:stylelint && yarn lint:eslint",
    "test": "tsc && jest"
  },
  "dependencies": {
    "@openfun/verna": "1.0.0-beta.1",
    "@rjsf/core": "6.8.0",
    "grommet": "2.56.0",
    "grommet-icons": "4.14.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-intl": "10.1.22",
    "react-is": "19.2.8",
    "styled-components": "6.5.3",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@babel/preset-react": "8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/styled-components": "5.1.36",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-module-resolver": "5.0.3",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "jest": "30.4.2",
    "postcss": "8.5.26",
    "sass": "1.102.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.1",
    "typescript": "4.8.4",
    "uuid": "14.0.1",
    "vite": "8.2.1"
  }
}
