{
  "name": "@openfun/verna",
  "version": "1.0.0-beta.1",
  "private": false,
  "keywords": [
    "react",
    "form",
    "json-schema"
  ],
  "description": "An extensible form builder based on React JSON Schema Form.",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "yarn build:dev",
    "build:dev": "vite build --watch --logLevel warn --mode development --config ./vite.dev.config.ts",
    "i18n:extract": "yarn formatjs extract --id-interpolation-pattern '[sha512:contenthash:base64:6]' --format crowdin './src/**/*.ts*' --ignore './src/**/*.spec.ts*' --out-file './i18n/frontend.json'",
    "i18n:compile": "yarn formatjs compile-folder --format crowdin ./i18n/locales ./src/translations",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "jest"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./*": "./*",
    "./package.json": "./package.json"
  },
  "repository": "https://github.com/openfun/verna",
  "author": {
    "name": "Open FUN (France Université Numérique)",
    "email": "fun.dev@fun-mooc.fr"
  },
  "bugs": {
    "url": "https://github.com/openfun/verna/issues"
  },
  "browserslist": [
    "last 2 versions",
    ">1%",
    "not dead"
  ],
  "license": "MIT",
  "dependencies": {
    "@rjsf/core": "6.11.0",
    "json-schema": "0.4.0",
    "lodash": "4.18.1",
    "uuid": "14.0.3"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-intl": "12.1.4"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@formatjs/cli": "6.16.34",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.26",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/uuid": "11.0.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-intl": "12.1.4",
    "rollup": "4.64.5",
    "tslib": "2.8.1",
    "typescript": "4.8.4",
    "vite": "8.3.4",
    "vite-plugin-dts": "5.1.2"
  }
}
